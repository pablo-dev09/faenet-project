# =====================================================
# FaeNet - Variaveis de ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores reais
# =====================================================

# Segredo usado para assinar sessoes / tokens.
# Em producao, gere um valor forte (ex: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-strong-random-string

# Ambiente: development | production
FLASK_ENV=development

# Banco de dados.
# Para desenvolvimento local (SQLite), use:
DATABASE_URL=sqlite:///faenet.db

# Para producao com PostgreSQL, use algo como:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/faenet

# Limite (em bytes) para upload de midia (padrao: 16 MB)
MAX_UPLOAD_BYTES=16777216

# Origem permitidas para CORS / cookies (separar por virgula)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Endereco do portal academico aberto pela secao FaeHub+.
# Para testar uma instancia local, substitua por http://127.0.0.1:5000/.
FAEHUB_URL=https://faehub-plus.onrender.com/
